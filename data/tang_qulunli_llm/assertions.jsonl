{"id": "TAN_001", "subject": "event:ev_tang_qulunli_llm_01", "predicate": "农具记载", "value_text": "江东田器尽于耒耜犁", "time": {"era_text": "唐末", "start": "0800"}, "place": "jiangdong", "source": "luilizi", "quote": "江东之田器，尽于是焉", "quote_status": "paraphrase_unverified", "layer": "inference", "confidence": 0.4, "scale": "province", "note": "[auto] 补层 inference", "dims": [2, 6], "_source_idx": 0, "_source_name": "陆龟蒙《耒耜经》", "_source_party": "后世官修", "_source_credibility": null, "_source_quote": "江东之田器，尽于是焉", "source_text": "经云：耒耜，农之始也。自耒耜至于犁，其备矣。江东之田器，尽于是焉。犁，冶金而为之者曰犁镵、曰犁壁；木而为之者曰犁底、曰压镵、曰策额、曰曲辕。曲辕之设，便于回旋，江南水田赖之。", "dim_source": "declared"}
